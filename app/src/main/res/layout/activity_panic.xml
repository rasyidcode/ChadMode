<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootPanicScrollView"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/panicContentContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="20dp"
        android:paddingTop="16dp"
        android:paddingEnd="20dp"
        android:paddingBottom="24dp">

        <!-- Top Header & Close Button -->
        <ImageButton
            android:id="@+id/btnClosePanic"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Close Emergency Shield"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="@color/text_secondary" />

        <TextView
            android:id="@+id/tvPanicTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:fontFamily="sans-serif-black"
            android:letterSpacing="0.05"
            android:text="@string/panic_shield_title"
            android:textColor="@color/crimson_glow"
            android:textSize="20sp"
            app:layout_constraintBottom_toBottomOf="@id/btnClosePanic"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/btnClosePanic"
            app:layout_constraintTop_toTopOf="@id/btnClosePanic" />

        <TextView
            android:id="@+id/tvPanicSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/panic_shield_subtitle"
            android:textColor="@color/text_muted"
            android:textSize="12sp"
            app:layout_constraintTop_toBottomOf="@id/btnClosePanic" />

        <!-- Mode Toggle (Box Breathing vs Urge Surfer) -->
        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/toggleModeGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:checkedButton="@id/btnTabBreathing"
            app:layout_constraintTop_toBottomOf="@id/tvPanicSubtitle"
            app:selectionRequired="true"
            app:singleSelection="true">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnTabBreathing"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:fontFamily="sans-serif-medium"
                android:text="@string/tab_box_breathing"
                android:textSize="11sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnTabUrgeSurfer"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:fontFamily="sans-serif-medium"
                android:text="@string/tab_urge_surfer"
                android:textSize="11sp" />
        </com.google.android.material.button.MaterialButtonToggleGroup>

        <!-- Container 1: Box Breathing Visualizer -->
        <LinearLayout
            android:id="@+id/layoutBreathingContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="visible"
            app:layout_constraintTop_toBottomOf="@id/toggleModeGroup">

            <com.rasyidcode.chadmode.ui.emergency.BreathingView
                android:id="@+id/breathingVisualizer"
                android:layout_width="240dp"
                android:layout_height="240dp"
                android:layout_gravity="center" />

            <TextView
                android:id="@+id/tvBreathingDesc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/breath_desc_inhale"
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                android:textStyle="italic" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnBreathingToggle"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:backgroundTint="@color/cyan_inhale"
                    android:text="@string/btn_start"
                    android:textColor="@color/black"
                    android:textSize="12sp"
                    app:cornerRadius="20dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnBreathingReset"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_marginStart="8dp"
                    android:text="@string/btn_reset"
                    android:textColor="@color/text_muted"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Container 2: 15-Minute Urge Surfer -->
        <LinearLayout
            android:id="@+id/layoutUrgeSurferContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone"
            app:layout_constraintTop_toBottomOf="@id/toggleModeGroup">

            <FrameLayout
                android:layout_width="220dp"
                android:layout_height="220dp"
                android:layout_gravity="center">

                <com.google.android.material.progressindicator.CircularProgressIndicator
                    android:id="@+id/progressUrgeWave"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_gravity="center"
                    app:indicatorColor="@color/emerald_active"
                    app:indicatorSize="210dp"
                    app:trackColor="@color/progress_track"
                    app:trackCornerRadius="8dp"
                    app:trackThickness="12dp"
                    tools:progress="30" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvUrgeTimer"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-black"
                        android:includeFontPadding="false"
                        android:textColor="@color/text_primary"
                        android:textSize="44sp"
                        tools:text="15:00" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:letterSpacing="0.1"
                        android:text="REMAINING"
                        android:textColor="@color/text_muted"
                        android:textSize="10sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </FrameLayout>

            <!-- Wave Stage Title and Description -->
            <TextView
                android:id="@+id/tvUrgeStageTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:fontFamily="sans-serif-black"
                android:textColor="@color/gold_primary"
                android:textSize="15sp"
                tools:text="Wave Rising" />

            <TextView
                android:id="@+id/tvUrgeStageDesc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                tools:text="Cravings are intensifying. Breathe and observe the impulse." />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnUrgeToggle"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:backgroundTint="@color/emerald_active"
                    android:text="@string/btn_start"
                    android:textColor="@color/black"
                    android:textSize="12sp"
                    app:cornerRadius="20dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnUrgeReset"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_marginStart="8dp"
                    android:text="@string/btn_reset"
                    android:textColor="@color/text_muted"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Stoic Reality Check Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardRealityCheck"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            app:cardBackgroundColor="@color/surface_card"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/surface_card_stroke"
            app:strokeWidth="1dp"
            app:layout_constraintTop_toBottomOf="@id/layoutBreathingContainer">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <TextView
                        android:id="@+id/tvRealityCheckHeader"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentStart="true"
                        android:letterSpacing="0.1"
                        android:text="@string/header_reality_check"
                        android:textColor="@color/amber_glow"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <ImageButton
                        android:id="@+id/btnShuffleRealityCheck"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:layout_alignParentEnd="true"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Shuffle Reality Check"
                        android:src="@android:drawable/ic_menu_rotate"
                        app:tint="@color/gold_accent" />
                </RelativeLayout>

                <TextView
                    android:id="@+id/tvRealityCheckQuote"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:lineSpacingExtra="4dp"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    android:textStyle="italic"
                    tools:text="10 seconds of cheap, artificial dopamine is not worth throwing away your hard-earned discipline." />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnNextRealityCheck"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_gravity="end"
                    android:layout_marginTop="8dp"
                    android:text="@string/btn_next_reality_check"
                    android:textColor="@color/gold_primary"
                    android:textSize="12sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Big Victory Button: I Conquered The Urge -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSurvivedUrge"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="20dp"
            android:backgroundTint="@color/emerald_active"
            android:fontFamily="sans-serif-black"
            android:letterSpacing="0.05"
            android:text="@string/btn_survived_urge"
            android:textColor="@color/black"
            android:textSize="15sp"
            app:cornerRadius="16dp"
            app:layout_constraintTop_toBottomOf="@id/cardRealityCheck" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>
