<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootRelapseScrollView"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/relapseContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="20dp"
        android:paddingTop="16dp"
        android:paddingEnd="20dp"
        android:paddingBottom="24dp">

        <!-- Top Header & Close Button -->
        <ImageButton
            android:id="@+id/btnCloseRelapse"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Cancel Reflection"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="@color/text_secondary" />

        <TextView
            android:id="@+id/tvRelapseTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:fontFamily="sans-serif-black"
            android:text="@string/title_relapse_reflection"
            android:textColor="@color/gold_primary"
            android:textSize="20sp"
            app:layout_constraintBottom_toBottomOf="@id/btnCloseRelapse"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/btnCloseRelapse"
            app:layout_constraintTop_toTopOf="@id/btnCloseRelapse" />

        <TextView
            android:id="@+id/tvRelapseSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/subtitle_relapse_reflection"
            android:textColor="@color/text_muted"
            android:textSize="12sp"
            app:layout_constraintTop_toBottomOf="@id/btnCloseRelapse" />

        <!-- Ending Streak Duration Banner -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardStreakEnding"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardBackgroundColor="@color/surface_card"
            app:cardCornerRadius="14dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/surface_card_stroke"
            app:strokeWidth="1dp"
            app:layout_constraintTop_toBottomOf="@id/tvRelapseSubtitle">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/label_streak_ended"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/tvStreakEndingDuration"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:fontFamily="sans-serif-black"
                    android:textColor="@color/flame_orange"
                    android:textSize="16sp"
                    tools:text="3d 14h 22m" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Triggers Section -->
        <TextView
            android:id="@+id/tvHeaderTriggers"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:letterSpacing="0.1"
            android:text="@string/header_select_trigger"
            android:textColor="@color/amber_glow"
            android:textSize="11sp"
            android:textStyle="bold"
            app:layout_constraintTop_toBottomOf="@id/cardStreakEnding" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chipGroupTriggers"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:layout_constraintTop_toBottomOf="@id/tvHeaderTriggers"
            app:selectionRequired="true"
            app:singleSelection="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/chipStress"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/trigger_stress" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipBoredom"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/trigger_boredom" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipLateNight"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/trigger_late_night" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipPeeking"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/trigger_peeking" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipLoneliness"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/trigger_loneliness" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipFatigue"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/trigger_fatigue" />
        </com.google.android.material.chip.ChipGroup>

        <!-- Location Context Section -->
        <TextView
            android:id="@+id/tvHeaderLocations"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:letterSpacing="0.1"
            android:text="@string/header_select_location"
            android:textColor="@color/amber_glow"
            android:textSize="11sp"
            android:textStyle="bold"
            app:layout_constraintTop_toBottomOf="@id/chipGroupTriggers" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chipGroupLocations"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:layout_constraintTop_toBottomOf="@id/tvHeaderLocations"
            app:selectionRequired="true"
            app:singleSelection="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/chipBedroom"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/location_bedroom" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipBathroom"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/location_bathroom" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipDesk"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/location_desk" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipCouch"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/location_couch" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipOtherLocation"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/location_other" />
        </com.google.android.material.chip.ChipGroup>

        <!-- Brain's Lie Note Input -->
        <TextView
            android:id="@+id/tvHeaderLie"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:letterSpacing="0.1"
            android:text="@string/header_brains_lie"
            android:textColor="@color/amber_glow"
            android:textSize="11sp"
            android:textStyle="bold"
            app:layout_constraintTop_toBottomOf="@id/chipGroupLocations" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/layoutInputLie"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="@string/hint_brains_lie"
            app:boxCornerRadiusBottomEnd="12dp"
            app:boxCornerRadiusBottomStart="12dp"
            app:boxCornerRadiusTopEnd="12dp"
            app:boxCornerRadiusTopStart="12dp"
            app:boxStrokeColor="@color/gold_primary"
            app:layout_constraintTop_toBottomOf="@id/tvHeaderLie">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etBrainsLie"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textMultiLine|textCapSentences"
                android:lines="3"
                android:maxLines="6"
                android:textColor="@color/text_primary" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Save Reflection & Reset Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSaveAndReset"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="24dp"
            android:backgroundTint="@color/crimson_dark"
            android:fontFamily="sans-serif-black"
            android:letterSpacing="0.05"
            android:text="@string/btn_log_and_reset"
            android:textColor="@color/white"
            android:textSize="15sp"
            app:cornerRadius="16dp"
            app:layout_constraintTop_toBottomOf="@id/layoutInputLie"
            app:strokeColor="@color/crimson_red"
            app:strokeWidth="1.5dp" />

        <!-- Cancel (Stay Strong) Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCancelRelapse"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:text="@string/btn_cancel"
            android:textColor="@color/text_muted"
            android:textSize="13sp"
            app:layout_constraintTop_toBottomOf="@id/btnSaveAndReset" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>
